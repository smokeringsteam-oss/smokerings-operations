# Copy this file to .env and fill in your key.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=AI...

# Optional: override the model used for content brainstorming/drafting.
# Defaults to the gemini-flash-latest alias, which has a low free-tier daily
# quota (20 requests/day as of writing). gemini-flash-lite-latest (the
# rolling alias for the current lite model) gives a much roomier free tier
# at the cost of some quality.
GEMINI_CONTENT_MODEL=gemini-flash-lite-latest

# Business backlog / sprint board (GitHub Projects v2). Needs a classic PAT
# with the "repo" and "project" scopes (read:project alone can read the
# board but can't update Status/Assignee or create the "Assigned To" field).
GITHUB_TOKEN=ghp_...
GITHUB_OWNER=your-github-org-or-user
GITHUB_PROJECT_NUMBER=1
# Repo that backlog draft cards get converted into real Issues in.
GITHUB_REPO=

# Weekend Prep Planner "Fetch from Odoo" — pulls confirmed, B2C (Individual
# contact type) Sales Orders in a date range straight into Step 1, instead of
# entering them by hand. Generate an API key in Odoo under
# Settings > Users & Companies > Users > (your user) > Account Security > API Keys.
ODOO_URL=https://yourcompany.odoo.com
ODOO_DB=yourcompany
ODOO_USERNAME=you@yourcompany.com
ODOO_API_KEY=

# Weekly Purchasing module — reads/writes vendors.csv, raw_materials.csv,
# inventory.csv, purchases.csv and smoking_sessions.csv from the separate
# knowledge-base repo. Daily View's recurring Mon–Fri task list (daily_view.csv)
# also reads from here. Defaults to ../knowledge-base/Data relative to this
# project (i.e. a sibling "knowledge-base" folder next to this one). Only set
# this if that repo lives somewhere else on your machine.
# KNOWLEDGE_BASE_DATA_DIR=D:\Personal GIT\knowledge-base\Data
